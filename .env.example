# Variables consommees par docker-compose.yml (docker compose lit .env
# automatiquement s'il est place a cote du fichier docker-compose.yml).
# Copier ce fichier en ".env" et ajuster - ne jamais committer le ".env" reel.

POSTGRES_USER=bourse_user
POSTGRES_PASSWORD=bourse_pass
POSTGRES_DB=bourse

PGADMIN_DEFAULT_EMAIL=admin@bourse.be
PGADMIN_DEFAULT_PASSWORD=admin

JWT_SECRET_KEY=changeme-generate-a-real-secret

# Notifications email (Etape 11 - desactivees par defaut)
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Destinataire des notifications - vide = on utilise MAIL_USER (on s'envoie a soi-meme)
NOTIFY_EMAIL=
