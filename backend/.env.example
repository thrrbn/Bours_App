ENVIRONMENT=development

# Ces valeurs par defaut correspondent au docker-compose.yml a la racine du
# projet. Si vous lancez le backend hors Docker (Etape 0 initiale), ajustez
# DB_HOST a "localhost" et assurez-vous que le port 5432 du conteneur "db"
# est bien expose (c'est le cas par defaut dans docker-compose.yml).
DB_HOST=db
DB_PORT=5432
DB_USER=bourse_user
DB_PASSWORD=bourse_pass
DB_NAME=bourse

JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MAIL_ENABLED=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=thrrbn@gmail.com
MAIL_PASSWORD=ankwfgficmaxrsqc
MAIL_FROM=thrrbn@gmail.com

BENZINGA_API_KEY=
LOG_LEVEL=INFO

# --- Analyste IA (LLM local, 16/08/2026 - voir docs/20-instance-locale-pc-mac.md) ---
# Reserve a une instance locale PC/Mac avec Ollama installe - NE JAMAIS
# definir ENABLE_LLM_ANALYST=true sur le .env utilise par le NAS deploye
# (pas de GPU la-bas, la feature y resterait de toute facon inutilisable).
ENABLE_LLM_ANALYST=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
